# ============================================================
#  ERP Gastronómico — Variables de entorno (copiar a .env)
#  NUNCA subas tu archivo .env a GitHub.
# ============================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- Base de datos (Supabase → Project Settings → Database → Connection string) ---
# Conexión por el pooler (Transaction mode, puerto 6543). La usa la app.
DATABASE_URL="postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa / Session pooler (puerto 5432). La usa Prisma para migraciones.
DIRECT_URL="postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- JWT ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRES_IN=8h

# --- Seguridad ---
BCRYPT_SALT_ROUNDS=10
# Orígenes permitidos para CORS (frontend), separados por coma
CORS_ORIGIN=http://localhost:5173

# --- Seed (contraseña de los usuarios de prueba) ---
SEED_PASSWORD=Password123!
