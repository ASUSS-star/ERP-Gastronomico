# URL de la API (backend). En producción (Netlify → Environment variables): https://tu-backend.vercel.app/api
VITE_API_URL=http://localhost:4000/api

# Tiempo real (opcional). Supabase → Project Settings → API Keys → llave PUBLICABLE (sb_publishable_...).
# Es pública por diseño; nunca pongas aquí la llave secreta.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
